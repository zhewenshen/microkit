#define PD_MASK 255
#define CHANNEL_MASK 63

#define BADGE_ADDR 500
#define HAVE_SIGNAL_ADDR 502
#define SHOULD_REPLY_ADDR 503

export fun handler_loop() {
    var have_reply = false;
    var badge = 0;

    while (true) {
        @microkit_have_signal(0, HAVE_SIGNAL_ADDR, 0, 0);
        var microkit_have_signal = lds 1 @base + HAVE_SIGNAL_ADDR * @biw;

        if (have_reply) {
            @microkit_reply_recv(0, BADGE_ADDR, 0, 0);
            have_reply = false;
        } else {
            if (microkit_have_signal) {
                @microkit_nb_send_recv(0, BADGE_ADDR, 0, 0);
            } else {
                @microkit_recv(0, BADGE_ADDR, 0, 0);
            }
        }

        badge = lds 1 @base + BADGE_ADDR * @biw;

        var is_fault = (badge >> 62) & 1;
        var is_endpoint = badge >> 63;

        if (is_fault) {
            var child = badge & PD_MASK;
            @microkit_fault_handler(0, child, 0, @base + SHOULD_REPLY_ADDR * @biw);
            var reply_to_fault = lds 1 @base + SHOULD_REPLY_ADDR * @biw;
            if (reply_to_fault) {
                have_reply = true;
            }
        } else {
            if (is_endpoint) {
                var channel = badge & CHANNEL_MASK;
                @microkit_protected_handler(0, channel, 0, 0);
                have_reply = true;
            } else {
                @microkit_notify_scan(0, badge, 0, 0);
            }
        }
    }

    return 0;
}
