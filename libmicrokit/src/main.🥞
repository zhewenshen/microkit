#define PD_MASK 255
#define CHANNEL_MASK 63

export fun pnk_handler_loop() {
    var have_reply = false;
    var reply_tag = 0;

    while (true) {
        var badge_addr = @base + 500 * @biw; 
        var tag = 0;

        var microkit_have_signal = false;
        if (have_reply) {
            tag = 0;
            @microkit_hello_pancake(0,0,0,0);
        } else {
            if (microkit_have_signal) {
                tag = 0;
                @microkit_hello_pancake(0,0,0,0);
            } else {
                tag = 0;
                @microkit_hello_pancake(0,0,0,0);
            }
        }

        var badge = lds 1 badge_addr;

        var is_endpoint = badge >> 63;
        var is_fault = (badge >> 62) & 1;

        have_reply = false;

        if (is_fault) {
            var reply_to_fault = 0;
            @microkit_hello_pancake(0,0,0,0);

            if (reply_to_fault) {
                have_reply = true;
            } else {
                if (is_endpoint) {
                    have_reply = true;
                    reply_tag = 0;
                    @microkit_hello_pancake(0,0,0,0);
                } else {
                    var idx = 0;

                    while (true) {
                        if (badge & 1) {
                            @microkit_hello_pancake(0,idx,0,0);
                        }

                        badge = badge >> 1;
                        idx = idx + 1;

                        if (badge != 0) { break; }
                    }
                }
            }
        }
    }

    return 0;
}
